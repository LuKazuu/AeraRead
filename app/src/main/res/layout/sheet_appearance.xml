<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sheet_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:id="@+id/sheet_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_handle" />

        <TextView
            android:id="@+id/sheet_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/appearance"
            android:textAppearance="@style/TextAppearance.Aera.SheetTitle" />

        <LinearLayout
            android:id="@+id/theme_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/theme"
                android:textAppearance="@style/TextAppearance.Aera.SectionLabel" />

            <LinearLayout
                android:id="@+id/theme_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pdf_theme_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/pdf_theme_apply"
                android:textAppearance="@style/TextAppearance.Aera.SectionLabel" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/pdf_theme_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pdf_full"
                    style="@style/Widget.Aera.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pdf_theme_full" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pdf_bg"
                    style="@style/Widget.Aera.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pdf_theme_background" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/pdf_margin_trim"
                android:textAppearance="@style/TextAppearance.Aera.SectionLabel" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/pdf_trim_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_trim_off"
                    style="@style/Widget.Aera.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pdf_trim_off" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_trim_normal"
                    style="@style/Widget.Aera.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pdf_trim_normal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_trim_max"
                    style="@style/Widget.Aera.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pdf_trim_max" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/typography_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/font"
                    android:textAppearance="@style/TextAppearance.Aera.SectionLabel" />

                <TextView
                    android:id="@+id/fonts_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="2dp"
                    android:text="@string/manage"
                    android:textAppearance="@style/TextAppearance.Aera.Link" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/font_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:fadingEdgeLength="32dp"
                android:requiresFadingEdge="horizontal"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/font_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="0dp"
                    android:paddingEnd="20dp"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/size"
                    android:textAppearance="@style/TextAppearance.Aera.SectionLabel" />

                <TextView
                    android:id="@+id/size_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Aera.Value" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/size_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="14"
                android:valueTo="30"
                app:labelBehavior="gone"
                app:tickVisible="false"
                app:trackHeight="3dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/line_spacing"
                    android:textAppearance="@style/TextAppearance.Aera.SectionLabel" />

                <TextView
                    android:id="@+id/line_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Aera.Value" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/line_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="125"
                android:valueTo="190"
                app:labelBehavior="gone"
                app:tickVisible="false"
                app:trackHeight="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/view_mode"
                android:textAppearance="@style/TextAppearance.Aera.SectionLabel" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/view_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scroll"
                    style="@style/Widget.Aera.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/view_scroll" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pages"
                    style="@style/Widget.Aera.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/view_pages" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:id="@+id/direction_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/page_turn"
                    android:textAppearance="@style/TextAppearance.Aera.SectionLabel" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/direction_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ltr"
                        style="@style/Widget.Aera.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ltr" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_rtl"
                        style="@style/Widget.Aera.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/rtl" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/keep_on"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:minHeight="48dp"
            android:text="@string/keep_screen_on"
            android:textAppearance="@style/TextAppearance.Aera.ItemTitle" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
